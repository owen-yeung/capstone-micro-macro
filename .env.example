LLM_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# Second provider for provider-compare (Qwen3.5-Flash via DashScope OpenAI-compatible API)
DASHSCOPE_API_KEY=
# QWEN_API_KEY=   # optional alias for DASHSCOPE_API_KEY
QWEN_MODEL=qwen3.5-flash
# Mainland default; international: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional alternate cheap provider (kept for earlier Groq harness)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional third provider
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

LLM_TIMEOUT=60
CODEDEMO_LLM_CONCURRENCY=3
